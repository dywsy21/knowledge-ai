# Copy to .env and adjust for your LLM gateway.
#
# The default provider is LiteLLM. For OpenAI-compatible local servers, keep the
# model prefixed with "openai/" so LiteLLM routes through its OpenAI-compatible
# adapter while using KNOWLEDGE_AI_API_BASE.

KNOWLEDGE_AI_PROVIDER=litellm
KNOWLEDGE_AI_MODEL=openai/mlx-qwen3.5-35b-a3b-claude-4.6-opus-reasoning-distilled
KNOWLEDGE_AI_API_BASE=http://192.168.1.106:1234/v1
KNOWLEDGE_AI_API_KEY=not-needed
KNOWLEDGE_AI_TEMPERATURE=0.2
KNOWLEDGE_AI_MAX_TOKENS=4096
KNOWLEDGE_AI_TIMEOUT_SECONDS=120

# MinIO object storage for the knowledge intake layer.
KNOWLEDGE_MINIO_ENDPOINT=host.docker.internal:9090
KNOWLEDGE_MINIO_ACCESS_KEY=change-me
KNOWLEDGE_MINIO_SECRET_KEY=change-me
KNOWLEDGE_MINIO_BUCKET=knowledge-ai
KNOWLEDGE_MINIO_SECURE=false

# Use deterministic offline behavior instead:
# KNOWLEDGE_AI_PROVIDER=mock
# KNOWLEDGE_AI_MODEL=mock/local
